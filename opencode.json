{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "database": {
      "type": "local",
      "command": ["/opt/homebrew/bin/mysql-mcp-server"],
      "environment": {
        "MYSQL_DSN": "{env:MYSQL_DSN}"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}",
        "X-MCP-Toolsets": "repos,issues,labels,pull_requests,git,actions,projects,notifications,users"
      }
    },
    "harness": {
      "type": "local",
      "command": ["./.venv/bin/python", "scripts/harness/harness_mcp.py"],
      "enabled": true,
      "timeout": 60000000
    },
    "21st": {
      "type": "remote",
      "url": "https://21st.dev/api/mcp",
      "oauth": false,
      "headers": {
        "x-api-key": "{env:TWENTYFIRST_API_KEY}"
      }
    }
  },

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.5:4b": {
          "name": "Qwen3.5 4B Local",
          "limit": {
            "context": 16384,
            "output": 2048
          }
        }
      }
    }
  }
}
